# Copie para .env.local (dev) e configure os mesmos nomes na Vercel.
# Projeto Supabase: esteira (org Softaria, sa-east-1) — ref llmumuazjcnvpdidndgq
#
# NENHUMA destas precisa do prefixo NEXT_PUBLIC_: nesta aplicação nada fala com
# o Supabase pelo navegador — escritório, chão e cliente final passam todos por
# Server Components e Server Actions. Sem o prefixo, a chave pode ficar como
# Secret na Vercel e nunca chega ao navegador.
#
# Os nomes NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# continuam sendo aceitos, para quem já os configurou.

SUPABASE_URL=https://llmumuazjcnvpdidndgq.supabase.co

# Chave publicável (protegida por RLS — é pública por natureza no modelo do
# Supabase, mas aqui ela não sai do servidor):
SUPABASE_ANON_KEY=sb_publishable_Ybrp8kigXXVqhGtIH_Fkxg_bWTSpfJY

# Chave SECRETA (service role) — NUNCA no navegador, NUNCA no git.
# Só o upload da foto do chão depende dela. Supabase → Project Settings →
# API keys → secret.
SUPABASE_SECRET_KEY=coloque_a_secret_key_aqui
