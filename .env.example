# ── Supabase ──────────────────────────────────────────────────
# Nada nesta aplicação fala com o Supabase pelo navegador: escritório, chão e
# cliente final passam todos por Server Components e Server Actions. Logo o
# prefixo NEXT_PUBLIC_ não é necessário — e sem ele a chave pode ficar como
# Secret na Vercel. (Os nomes com NEXT_PUBLIC_ continuam aceitos.)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OBRIGATÓRIA a partir do B9/B10. Sem ela não existem: autocadastro de oficina,
# criação de acesso para uma segunda pessoa, exibição da foto do chão e a
# gravação do webhook de cobrança. As telas dizem isso quando ela falta, em vez
# de falhar no meio.
SUPABASE_SECRET_KEY=

# ── Cobrança (Stripe) ─────────────────────────────────────────
# Enquanto estiver vazio, o produto funciona inteiro e a tela de conta diz que
# o pagamento automático não está ligado. Ver docs/ligar-a-cobranca.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_BASE=
STRIPE_PRECO_MEDIO=
STRIPE_PRECO_GRANDE=

# Endereço público do site, para o checkout saber para onde voltar.
# Sem ele, cai em VERCEL_URL e depois em http://localhost:3000.
SITE_URL=
